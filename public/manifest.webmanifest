{
  "name": "PaperKit · private PDF tools",
  "short_name": "PaperKit",
  "description": "Merge, compress, sign, protect, OCR and exam-ready photos. Everything runs on your device. Nothing is uploaded.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0E0C16",
  "theme_color": "#0E0C16",
  "categories": ["productivity", "utilities", "education"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Compress PDF", "short_name": "Compress", "url": "/#/compress", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Merge PDFs", "short_name": "Merge", "url": "/#/merge", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Images to PDF", "short_name": "Images → PDF", "url": "/#/images-to-pdf", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Exam mode", "short_name": "Exam", "url": "/#/exam", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "files", "accept": ["application/pdf", ".pdf", "image/*", ".jpg", ".jpeg", ".png", ".heic", ".heif", ".webp"] }] }
  },
  "file_handlers": [
    { "action": "/", "accept": { "application/pdf": [".pdf"], "image/jpeg": [".jpg", ".jpeg"], "image/png": [".png"] }, "launch_type": "single-client" }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
